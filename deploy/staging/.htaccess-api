# Plantilla .htaccess — API de staging /certificados_staging/api/
#
# Copiar como .htaccess dentro de public_html/certificados_staging/api/.
# Bloquea acceso directo a src/ y config/ y enruta todo a index.php.
# El router PHP (normalizePath) ya acepta /certificados_staging/api.
#
# Config externa de staging: descomentar y completar la ruta real fuera de Git.
# SetEnv CERTIFICADOS_CONFIG_PATH "/ruta/externa/staging/certificados-config.php"
#
# Sin secretos en este archivo: solo SetEnv apuntando a la ruta externa.

RewriteEngine On
RewriteBase /certificados_staging/api/

# Bloquear acceso directo a código y configuración.
RewriteRule ^(src|config)/ - [F,L]

# Fallback a index.php para todas las rutas API no existentes.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . index.php [L]